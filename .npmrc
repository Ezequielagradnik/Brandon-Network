# Defensa contra supply chain attacks en npm: el malware suele ejecutarse
# via postinstall al instalar. Ninguna dependencia nuestra usa install
# scripts (verificado 2026-08-05), asi que esto no rompe nada.
# Si una dependencia futura necesita build scripts (ej: binarios nativos
# sin prebuilds), correr su build a mano o reevaluar esta linea.
ignore-scripts=true
